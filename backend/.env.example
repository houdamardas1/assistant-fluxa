# Environment
ENVIRONMENT=development
DEBUG=True

# Security (generer avec : python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VERIFY_MODEL=openai/gpt-oss-120b
GROQ_MAX_RETRIES=8
# RAG
RAG_TOP_K_VERIFY=15
RAG_VERIFY_CHARS=1200

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Audit
AUDIT_DB_PATH=data/audit.db

USERS_DB_PATH=data/users.db

# --- PostgreSQL (docker compose) : remplacer par de vraies valeurs dans .env ---
POSTGRES_USER=morocco
POSTGRES_DB=morocco
POSTGRES_PASSWORD=changez-moi
PGADMIN_DEFAULT_EMAIL=admin@exemple.com
PGADMIN_DEFAULT_PASSWORD=changez-moi
# DSN lu par l'API (le compose le construit lui-meme). Vide = SQLite local.
# PG_DSN=postgresql://morocco:changez-moi@127.0.0.1:15432/morocco

# Prix du modele LLM en USD par million de tokens (page tarifs Groq) : sert au cout estime
LLM_PRICE_IN_PER_M=
LLM_PRICE_OUT_PER_M=
